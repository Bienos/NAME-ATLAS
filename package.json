{
  "name": "name-atlas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Name Atlas monorepo — control plane in AGENTS.md, ARCHITECTURE.md, docs/adr/",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present run test",
    "test:integration": "pnpm --filter @name-atlas/integration-tests run test:integration",
    "db:migrate": "pnpm --filter @name-atlas/db run migrate",
    "db:generate-types": "pnpm --filter @name-atlas/db run generate-types",
    "demo:surname": "pnpm --filter @name-atlas/truth run demo:surname",
    "demo:surname-rank": "pnpm --filter @name-atlas/truth run demo:surname-rank",
    "demo:surname-rarity": "pnpm --filter @name-atlas/truth run demo:surname-rarity",
    "demo:surname-distribution": "pnpm --filter @name-atlas/truth run demo:surname-distribution",
    "demo:surname-candidates": "pnpm --filter @name-atlas/resolver run demo:surname-candidates",
    "measure:fuzzy-recall": "pnpm --filter @name-atlas/resolver run measure:fuzzy-recall"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "fast-check": "4.10.1",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
