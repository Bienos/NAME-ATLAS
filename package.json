{
  "name": "name-atlas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Name Atlas monorepo — control plane in AGENTS.md, ARCHITECTURE.md, docs/adr/",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:ids": "bash scripts/check-unique-ids.sh",
    "check:vm": "bash scripts/check-vm-dumps.sh",
    "test:backup": "python3 scripts/test-backup.py",
    "test": "pnpm -r --if-present run test",
    "test:integration": "pnpm --filter @name-atlas/integration-tests run test:integration",
    "test:golden": "pnpm --filter @name-atlas/golden-tests run test:golden",
    "test:e2e": "pnpm --filter @name-atlas/e2e-tests test:e2e",
    "e2e:seed": "bash tests/e2e/seed.sh",
    "db:migrate": "pnpm --filter @name-atlas/db run migrate",
    "db:generate-types": "pnpm --filter @name-atlas/db run generate-types",
    "fetch:pesel": "tsx packages/sources/bin/fetch-pesel.ts",
    "local:setup": "bash scripts/local-setup.sh",
    "seo:backfill-slugs": "pnpm --filter @name-atlas/seo run backfill-slugs",
    "truth:derive-batch": "pnpm --filter @name-atlas/truth run derive-batch",
    "truth:derive-shift": "pnpm --filter @name-atlas/truth run derive-shift",
    "truth:derive-given-names": "pnpm --filter @name-atlas/truth run derive-given-names",
    "truth:derive-given-name-births": "pnpm --filter @name-atlas/truth run derive-given-name-births",
    "truth:derive-given-name-meanings": "pnpm --filter @name-atlas/truth run derive-given-name-meanings",
    "truth:list-facts": "pnpm --filter @name-atlas/truth run build-list-facts",
    "truth:given-name-list-facts": "pnpm --filter @name-atlas/truth run build-given-name-list-facts",
    "truth:archive-load": "pnpm --filter @name-atlas/truth run archive-load",
    "truth:bearers-load": "pnpm --filter @name-atlas/truth run bearers-load",
    "coverage:report": "pnpm --silent --filter @name-atlas/truth run coverage-report",
    "coverage:assess": "pnpm --silent --filter @name-atlas/truth run coverage-assess",
    "discovery:index": "pnpm --silent --filter @name-atlas/truth run discovery-index",
    "premium:eligibility": "pnpm --silent --filter @name-atlas/truth run premium-eligibility",
    "report:build": "pnpm --silent --filter @name-atlas/truth run report-build",
    "demo:surname": "pnpm --filter @name-atlas/truth run demo:surname",
    "demo:surname-rank": "pnpm --filter @name-atlas/truth run demo:surname-rank",
    "demo:surname-rarity": "pnpm --filter @name-atlas/truth run demo:surname-rarity",
    "demo:surname-distribution": "pnpm --filter @name-atlas/truth run demo:surname-distribution",
    "demo:surname-meaning": "pnpm --filter @name-atlas/truth run demo:surname-meaning",
    "import-onomastics": "pnpm --filter @name-atlas/sources run import-onomastics",
    "seed:sources": "pnpm --filter @name-atlas/sources run seed-sources",
    "import:teryt": "pnpm --filter @name-atlas/sources run import-teryt",
    "import:given-names": "pnpm --filter @name-atlas/sources run import-given-names",
    "import:given-name-births": "pnpm --filter @name-atlas/sources run import-given-name-births",
    "import:given-name-meanings": "pnpm --filter @name-atlas/sources run import-given-name-meanings",
    "demo:surname-candidates": "pnpm --filter @name-atlas/resolver run demo:surname-candidates",
    "measure:fuzzy-recall": "pnpm --filter @name-atlas/resolver run measure:fuzzy-recall",
    "enqueue:derive": "pnpm --filter @name-atlas/queue run enqueue:derive",
    "worker": "pnpm --filter worker run start"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "fast-check": "4.10.1",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
