{
  "name": "@name-atlas/db",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "tsx bin/migrate.ts",
    "generate-types": "kysely-codegen --dialect=postgres --url=\"$DATABASE_URL\" --out-file=src/generated/db.ts"
  },
  "dependencies": {
    "kysely": "0.29.6",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "kysely-codegen": "0.20.0"
  }
}
