# Name Atlas — environment variables
#
# Copy to .env and fill in real values for local development. Never commit
# a real .env file. CI and Testcontainers set these independently; this
# file documents names only (AGENTS.md, TASK-001 §6).
#
# Every variable the code actually reads is listed here, with the file that
# reads it. A variable documented but never read is noted as such.

# --- required -------------------------------------------------------------

# PostgreSQL connection string. Read by packages/db/src/config.ts (pool,
# migrator, kysely-codegen) and therefore by every app. Must point at a
# PostgreSQL instance that can enable the `postgis` and `pg_trgm`
# extensions — see docs/adr/0002-db-access.md.
# Example (local dev): postgres://postgres:postgres@localhost:5432/name_atlas
DATABASE_URL=

# --- public app behaviour -------------------------------------------------

# The public origin, with scheme and no trailing slash, used to build
# canonical URLs, Open Graph URLs and the share link
# (apps/web/src/lib/surname-page.tsx). Unset means those are rendered as
# relative paths, which is correct for local development and wrong for
# anything a crawler or a share sheet will read.
# Example: https://nameatlas.example
SITE_ORIGIN=

# Set to the exact string `true` to let a surname page be indexed when
# docs/canonical/21 §42's policy passes (apps/web/src/lib/seo.ts). Unset or
# anything else means every page renders `noindex, follow`. This is the
# alpha gate from ADR-0009 §5: leave it unset until a surname cohort has
# been through manual QA.
SEO_INDEXING_ENABLED=

# --- accounts (ADR-0027, TASK-062) ------------------------------------------
#
# Accounts are ON only when ALL FIVE of these are set: the three below,
# SITE_ORIGIN (above; the mails' links are absolute) and CRON_SECRET (below).
# Any one missing and there is no link, no page and no route, and the privacy
# notice and the terms read as they did before accounts. The header's link and
# the legal text are read at build, so redeploy after setting them.

# The accounts connection: a PostgreSQL connection string for the role
# `nameatlas_app`, which reads and writes schema `accounts` and nothing in
# `public` (ops/vm/accounts-roles.sql). Read by packages/db/src/config.ts. It is
# never DATABASE_URL, whose read-only role has no grant on accounts. Unset means
# accounts are off.
# Example (local dev): postgres://nameatlas_app:...@localhost:5432/name_atlas
# Example (production, the VM's PgBouncer; ops/vm/README.md "Turning accounts on"):
#   postgresql://nameatlas_app:<VM_DB_APP_PASSWORD>@<VM_HOST>:6432/name_atlas?uselibpqcompat=true&sslmode=require
ACCOUNTS_DATABASE_URL=

# The mail sender: Resend's API key and the From header, which must be an
# address on a domain verified with Resend. Read by
# packages/accounts/src/config.ts. Both or neither: missing either means
# accounts are off, because a sign-up that cannot be confirmed is not accepted.
# Example: Name Atlas <konto@your-domain.example>
RESEND_API_KEY=
ACCOUNTS_MAIL_FROM=

# The bearer Vercel's cron sends to GET /api/cron/accounts-purge, daily
# (apps/web/vercel.json). The purge deletes a pending address after 7 days, as
# the privacy notice says, so accounts are off without a secret to protect it.
# Any long random string; Vercel sends it as `Authorization: Bearer <value>`.
CRON_SECRET=

# --- admin ----------------------------------------------------------------

# Set to the exact string `true` to let the read-only evidence inspector
# answer (apps/admin/src/lib/inspect.ts). It is NOT authentication —
# docs/canonical/22 §6 is not implemented — so the admin app must not be
# reachable from a network whatever this is set to.
ADMIN_INSPECTOR_ENABLED=

# --- worker ---------------------------------------------------------------

# Redis connection string for the BullMQ queue
# (packages/queue/src/connection.ts). Read by apps/worker only; the public
# read path never touches the queue.
# Example (local dev): redis://localhost:6379
REDIS_URL=

# --- diagnostics ----------------------------------------------------------

# Log level for the structured logger (packages/logging/src/logger.ts).
# One of: debug, info, warn, error. Defaults to info.
LOG_LEVEL=

# --- tests ----------------------------------------------------------------

# An already-running PostgreSQL server for the integration suite, used
# instead of starting the pinned container
# (packages/testing/src/postgres-container.ts). Each suite creates and drops
# a uniquely named database on it. Point it at a server, not at a specific
# database: postgres://user:pass@localhost:5432/postgres
TEST_DATABASE_URL=

# --- documented previously, not read by any code --------------------------
#
# WEB_PORT and ADMIN_PORT were listed here but nothing reads them. Next takes
# its port from `next start --port` or `PORT`. They are left out rather than
# kept as a variable that does nothing.
