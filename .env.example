# Name Atlas — environment variables
#
# Copy to .env and fill in real values for local development. Never commit
# a real .env file. CI and Testcontainers set these independently; this
# file documents names only (AGENTS.md, TASK-001 §6).

# PostgreSQL connection string used by packages/db (pool, migrator,
# kysely-codegen) and by apps/web/apps/admin if they need direct DB access
# later. Must point at a PostgreSQL instance that can enable the `postgis`
# and `pg_trgm` extensions — see docs/adr/0002-db-access.md.
# Example (local dev): postgres://postgres:postgres@localhost:5432/name_atlas
DATABASE_URL=

# Port apps/web listens on locally. Next.js defaults to 3000 if unset.
WEB_PORT=

# Port apps/admin listens on locally. Kept separate from apps/web so both
# can run at once in local development.
ADMIN_PORT=

# Log level for structured logging in apps/worker and packages/db CLI
# scripts. One of: debug, info, warn, error.
LOG_LEVEL=
